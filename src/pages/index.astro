---
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import EngineeringSection from '../components/sections/EngineeringSection.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ProductsSection from '../components/sections/ProductsSection.astro';
import WhyUsSection from '../components/sections/WhyUsSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyInfo } from '../lib/data';

const { legalName } = getCompanyInfo();
---

<BaseLayout title={legalName}>
  <SiteHeader slot="header" />
  <HeroSection />
  <AboutSection />
  <ProductsSection />
  <EngineeringSection />
  <WhyUsSection />
  <ContactSection />
  <SiteFooter slot="footer" />
</BaseLayout>
