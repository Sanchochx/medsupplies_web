---
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import ProductsSection from '../components/sections/ProductsSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCompanyInfo } from '../lib/data';

const { legalName } = getCompanyInfo();
---

<BaseLayout title={legalName}>
  <SiteHeader slot="header" />
  {/* Section anchors in page order; each one is replaced by its section component (Epic 03). */}
  <HeroSection />
  <AboutSection />
  <ProductsSection />
  <section id="engineering"></section>
  <section id="why-us"></section>
  <section id="contact"></section>
  <SiteFooter slot="footer" />
</BaseLayout>
