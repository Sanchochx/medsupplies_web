---
import type { DivisionLine as DivisionLineData } from '../../lib/data';
import { Button, Container } from '../ui';
import DivisionLine from './DivisionLine.astro';

export interface DivisionPanelProps {
  id: string;
  /** Id of the division title that names this region. */
  labelledBy: string;
  lines: readonly DivisionLineData[];
}

type Props = DivisionPanelProps;

const { id, labelledBy, lines } = Astro.props;
---

{/*
 * Collapsed by default: `0fr` rows give it no height and `inert` + `aria-hidden` keep its content
 * out of the tab order and the accessibility tree. The toggle script flips `data-state` on the
 * division and these attributes together; the row animates `0fr` → `1fr`.
 */}
<div
  id={id}
  role="region"
  aria-labelledby={labelledBy}
  aria-hidden="true"
  inert
  data-division-panel
  class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-350 ease-out group-data-[state=open]/division:grid-rows-[1fr] data-instant:transition-none"
>
  <div class="min-h-0 overflow-hidden">
    <div class="border-t-4 border-primary bg-surface-container-lowest py-space-xl lg:py-14">
      <Container class="flex flex-col gap-space-xl lg:gap-14">
        {lines.map((line, index) => (
          <DivisionLine line={line} reversed={index % 2 === 1} />
        ))}
        <div class="border-t border-outline-variant/60 pt-space-lg">
          <Button href="/#contacto" size="lg" fullWidth class="sm:w-auto">
            Solicitar cotización
          </Button>
        </div>
      </Container>
    </div>
  </div>
</div>
