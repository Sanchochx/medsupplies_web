---
import type { DivisionLine } from '../../lib/data';
import { formatLineLabel } from '../../lib/divisions/lineTabs';
import { Chip, Icon, IconTile } from '../ui';

export interface DivisionLineProps {
  line: DivisionLine;
  /** Position in the panel; drives the "Línea NN" pill. */
  index: number;
  /** Id of this tab panel. */
  id: string;
  /** Id of the tab that names this panel. */
  tabId: string;
  hidden?: boolean;
}

type Props = DivisionLineProps;

const { line, index, id, tabId, hidden = false } = Astro.props;
---

{/* `tabindex="0"` lets keyboard users reach the panel, which has no focusable content of its own. */}
<div
  role="tabpanel"
  id={id}
  aria-labelledby={tabId}
  tabindex="0"
  hidden={hidden}
  class="flex flex-col gap-space-md rounded-2xl focus-visible:outline-offset-4"
>
  <div class="flex flex-col items-start gap-space-sm">
    <Chip variant="soft">{formatLineLabel(index)}</Chip>
    <h3 class="font-heading text-headline-md font-bold text-on-primary-fixed">{line.title}</h3>
    {line.badge && (
      <span class="inline-flex items-center gap-1.5 rounded-full bg-surface-container-lowest px-3 py-1 text-label-md text-on-primary-fixed-variant ring-1 ring-primary-fixed-dim">
        <Icon name="verified" size={16} class="text-primary" />
        {line.badge}
      </span>
    )}
    {line.description && (
      <p class="max-w-prose text-body-md text-on-surface-variant">{line.description}</p>
    )}
  </div>

  {/* Grid rows stretch their cells, so chips in the same row keep the same height; names wrap. */}
  {line.kind === 'products' ? (
    <ul class="grid grid-cols-1 gap-space-sm sm:grid-cols-2 xl:grid-cols-3">
      {line.items.map((item) => (
        <li class="flex items-center gap-space-sm rounded-xl bg-surface-container-high px-space-md py-3 text-body-sm font-medium text-on-primary-fixed">
          <Icon name="check-circle" size={18} class="text-primary" />
          <span>{item}</span>
        </li>
      ))}
    </ul>
  ) : (
    <ul class="grid grid-cols-1 gap-space-sm sm:grid-cols-2 sm:gap-space-md">
      {line.items.map(({ name, icon }) => (
        <li class="flex items-center gap-space-md rounded-xl bg-surface-container-lowest p-space-sm pr-space-md text-body-md font-medium text-on-primary-fixed shadow-sm">
          <IconTile icon={icon} />
          <span>{name}</span>
        </li>
      ))}
    </ul>
  )}
</div>
