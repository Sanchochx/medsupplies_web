---
import { getProductLines } from '../../lib/data';
import { Button, Container, SectionHeader } from '../ui';
import ProductLineCard from './ProductLineCard.astro';

const HEADING_ID = 'products-heading';

const productLines = await getProductLines();
---

<section id="productos" aria-labelledby={HEADING_ID} class="w-full bg-primary py-space-xl lg:py-24">
  <Container class="flex flex-col gap-space-xl">
    {/* Inverse ring on the header only: the white cards below keep the default blue ring. */}
    <div class="focus-ring-inverse flex flex-col justify-between gap-space-md md:flex-row md:items-end">
      {/* Wrapped because SectionHeader's own max-w-3xl would win over a max-w-2xl class. */}
      <div class="max-w-2xl">
        <SectionHeader
          headingId={HEADING_ID}
          tone="primary"
          heading="Portafolio de Productos"
          lead="Una cadena de suministro clínico sujeta a estrictos controles de trazabilidad, calificación de proveedores y registros sanitarios vigentes."
          leadSize="md"
        />
      </div>
      <Button href="/#contacto" variant="link-inverse" class="self-start md:self-auto">
        Solicitar lista de precios completa
      </Button>
    </div>

    <ul class="grid grid-cols-1 gap-gutter lg:grid-cols-3">
      {productLines.map((line) => (
        <li>
          <ProductLineCard line={line} />
        </li>
      ))}
    </ul>
  </Container>
</section>
