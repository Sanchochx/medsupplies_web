---
import { getProductLines } from '../../lib/data';
import { Button, Container, SectionHeader } from '../ui';
import ProductLineCard from './ProductLineCard.astro';

const HEADING_ID = 'products-heading';

const productLines = await getProductLines();
---

<section id="products" aria-labelledby={HEADING_ID} class="w-full bg-surface py-space-xl lg:py-24">
  <Container class="flex flex-col gap-space-xl">
    <div class="flex flex-col justify-between gap-space-md md:flex-row md:items-end">
      {/* Wrapped because SectionHeader's own max-w-3xl would win over a max-w-2xl class. */}
      <div class="max-w-2xl">
        <SectionHeader
          headingId={HEADING_ID}
          eyebrow="Certified Hospital Supply"
          heading="Product Portfolio"
          lead="A clinical supply chain subject to strict traceability controls, supplier qualification and valid health registrations."
          leadSize="md"
        />
      </div>
      <Button href="/#contact" variant="link" class="self-start md:self-auto">
        Request the full price list
      </Button>
    </div>

    <ul class="grid grid-cols-1 gap-gutter lg:grid-cols-3">
      {productLines.map((line) => (
        <li>
          <ProductLineCard line={line} />
        </li>
      ))}
    </ul>
  </Container>
</section>
