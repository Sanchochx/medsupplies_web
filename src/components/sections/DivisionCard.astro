---
import type { ServiceDivision } from '../../lib/data';
import { Icon, IconTile } from '../ui';
import DivisionItem from './DivisionItem.astro';

export interface DivisionCardProps {
  division: ServiceDivision;
  /** Screen-reader-only suffix of the footer link, which names its destination. */
  linkHint: string;
  class?: string;
}

type Props = DivisionCardProps;

const { division, linkHint, class: className } = Astro.props;
const { label, title, icon, description, items, footerLabel, href } = division;

/*
 * From xl the card is a subgrid over the rows its parent list defines (header, description, one
 * row per item slot, footer), so every row lines up across the three columns. Spacing comes from
 * margins and padding, hence `gap-y-0`. The list sets `--division-rows` and `--division-items`.
 * Below xl it is a plain column with the footer pinned to the bottom by `mt-auto`.
 */
const SUBGRID = 'xl:row-span-(--division-rows) xl:grid xl:grid-rows-subgrid xl:gap-y-0';
---

<article
  class:list={[
    'relative flex h-full flex-col rounded-2xl border border-surface-variant bg-surface-container-lowest p-space-lg shadow-sm',
    'transition duration-200 hover:shadow-md motion-safe:hover:-translate-y-1',
    SUBGRID,
    className,
  ]}
>
  <span
    aria-hidden="true"
    class="absolute top-space-lg right-space-lg size-2 rounded-full bg-primary"
  ></span>

  <header class="flex items-center gap-space-md pr-space-md">
    <IconTile icon={icon} size="lg" />
    <div class="flex flex-col">
      <p class="text-label-sm tracking-widest text-primary uppercase">{label}</p>
      <h3 class="font-heading text-headline-sm font-bold text-on-surface">{title}</h3>
    </div>
  </header>

  <p class="mt-space-md text-body-sm leading-relaxed text-on-surface-variant">{description}</p>

  <ul class="mt-space-md flex flex-col gap-space-sm border-t border-surface-variant pt-space-md xl:grid xl:grid-rows-subgrid xl:row-span-(--division-items)">
    {items.map((item) => (
      <DivisionItem item={item} />
    ))}
  </ul>

  <footer class="mt-auto pt-space-lg">
    <a
      href={href}
      class="flex items-center justify-between gap-space-sm border-t border-surface-variant pt-space-md text-label-lg font-bold text-primary hover:underline"
    >
      <span>
        {footerLabel}
        <span class="sr-only"> {linkHint}</span>
      </span>
      <Icon name="arrow-forward" size={18} />
    </a>
  </footer>
</article>
