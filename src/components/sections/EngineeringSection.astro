---
import { getEngineeringServices } from '../../lib/data';
import { Container, SectionHeader } from '../ui';
import ServiceCard from './ServiceCard.astro';

const HEADING_ID = 'engineering-heading';

const services = await getEngineeringServices();
---

<section
  id="engineering"
  aria-labelledby={HEADING_ID}
  class="focus-ring-inverse relative w-full overflow-hidden bg-inverse-surface py-space-xl text-inverse-on-surface lg:py-24"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(var(--color-primary-fixed-dim)_1px,transparent_1px)] bg-size-[24px_24px] opacity-10"
  ></div>

  <Container class="relative z-10 flex flex-col gap-space-xl">
    <SectionHeader
      headingId={HEADING_ID}
      tone="dark"
      eyebrow="Specialized Technical Services"
      heading="Biomedical Engineering & Clinical Support"
      lead="We ensure patient safety and maximum operational continuity of hospital infrastructure through preventive engineering methodologies, metrological calibration and technovigilance management."
    />

    <ul class="grid grid-cols-1 gap-gutter md:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <li>
          <ServiceCard service={service} />
        </li>
      ))}
    </ul>
  </Container>
</section>
