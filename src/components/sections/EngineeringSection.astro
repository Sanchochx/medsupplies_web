---
import { getEngineeringServices } from '../../lib/data';
import { Container, SectionHeader } from '../ui';
import EngineeringCallout from './EngineeringCallout.astro';
import ServiceCard from './ServiceCard.astro';

const HEADING_ID = 'engineering-heading';

const services = await getEngineeringServices();
---

<section
  id="ingenieria"
  aria-labelledby={HEADING_ID}
  class="w-full bg-surface-container-lowest py-space-xl lg:py-24"
>
  <Container class="flex flex-col gap-space-xl">
    <SectionHeader
      headingId={HEADING_ID}
      heading="Ingeniería Biomédica y Soporte Clínico"
      lead="Garantizamos la seguridad del paciente y la máxima continuidad operativa de la infraestructura hospitalaria mediante metodologías de ingeniería preventiva, calibración metrológica y gestión de tecnovigilancia."
    />

    <ul class="grid grid-cols-1 gap-gutter md:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <li>
          <ServiceCard service={service} />
        </li>
      ))}
    </ul>

    <EngineeringCallout />
  </Container>
</section>
