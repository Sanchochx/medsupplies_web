---
import { getMetrics } from '../../lib/data';

const metrics = getMetrics();
---

{/*
  A description list pairs each figure with its label for screen readers (label = term, figure =
  description); `flex-col-reverse` shows the figure on top, as in the design (`justify-end` packs it to the top
  of the card, so figures in the same row stay aligned). On the narrowest
  phones the 2-column cards are too small for 40px figures, so they step down to 28px until `sm`.
*/}
<dl class="grid grid-cols-2 gap-space-sm sm:gap-gutter lg:grid-cols-4">
  {metrics.map(({ value, label }) => (
    <div class="flex min-w-0 flex-col-reverse justify-end rounded-xl bg-surface-container-lowest p-space-md shadow-sm">
      <dt class="mt-1 text-body-sm text-on-surface-variant">{label}</dt>
      <dd class="font-heading text-headline-xl-mobile font-bold text-primary sm:text-headline-xl">
        {value}
      </dd>
    </div>
  ))}
</dl>
