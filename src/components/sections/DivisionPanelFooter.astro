---
import { lineCounterText } from '../../lib/divisions/lineTabs';
import { Icon } from '../ui';

export interface DivisionPanelFooterProps {
  /** Number of lines in the panel. */
  count: number;
}

type Props = DivisionPanelFooterProps;

const { count } = Astro.props;

const ARROW_CLASSES =
  'inline-flex size-11 cursor-pointer items-center justify-center rounded-full bg-primary text-on-primary shadow-sm transition duration-150 ease-out hover:bg-secondary hover:shadow-md active:scale-95 disabled:cursor-not-allowed disabled:opacity-40 disabled:hover:bg-primary disabled:hover:shadow-sm disabled:active:scale-100';
---

{/*
 * The first line starts selected, so "previous" starts disabled; lineTabs.ts keeps both in sync.
 * The footer enters last when the panel opens; its delay depends on the line shown, so
 * panelMotion.ts sets it on the panel.
 */}
<div
  class="flex items-center justify-between gap-space-md border-t border-outline-variant/60 pt-space-lg sm:justify-start"
  data-motion="footer"
>
  <p data-line-counter aria-live="polite" class="text-body-sm text-on-surface-variant">
    {lineCounterText(0, count)}
  </p>
  <div class="flex gap-space-sm">
    <button type="button" data-line-prev aria-label="Línea anterior" disabled class={ARROW_CLASSES}>
      <Icon name="arrow-back" size={20} />
    </button>
    <button
      type="button"
      data-line-next
      aria-label="Línea siguiente"
      disabled={count <= 1}
      class={ARROW_CLASSES}
    >
      <Icon name="arrow-forward" size={20} />
    </button>
  </div>
</div>
