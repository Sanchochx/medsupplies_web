---
import { getTrustBadges } from '../../lib/data';
import { IconTile } from '../ui';

const badges = getTrustBadges();
---

{/*
  The icon sits beside the text only when a card is wide enough for whole words: the 2 wide
  columns from `sm` and the 4 columns from `lg`. Narrower cards (phones, and 4 columns at `md`)
  stack the icon above the text so words never break mid-word.
*/}
<ul class="mt-space-xl grid grid-cols-2 gap-space-sm pt-space-lg md:grid-cols-4 md:gap-gutter">
  {badges.map(({ icon, title, text }) => (
    <li class="flex min-w-0 flex-col items-start gap-3 rounded-xl bg-surface-container-lowest p-space-md shadow-sm sm:flex-row sm:items-center md:flex-col md:items-start lg:flex-row lg:items-center">
      <IconTile icon={icon} />
      <div class="min-w-0 wrap-break-word">
        <h2 class="text-label-md text-on-surface">{title}</h2>
        <p class="text-body-sm text-on-surface-variant">{text}</p>
      </div>
    </li>
  ))}
</ul>
