---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { slideStates } from '../../lib/divisions/photoRotation';
import { PANEL_MOTION_DELAYS, panelMotionDelayStyle } from '../../lib/motion/panelMotionTimeline';

export interface DivisionPhotoLoopProps {
  /** The division's product photos; two or more crossfade in a loop. */
  images: readonly ImageMetadata[];
  class?: string;
}

type Props = DivisionPhotoLoopProps;

const { images, class: className } = Astro.props;
const rotates = images.length > 1;
const states = slideStates(0, images.length);

// The photo column is at most ~2/5 of the 1320px container (≈ 530px), up to 2× on dense screens.
const widthsFor = (image: ImageMetadata): number[] => [
  ...new Set([320, 480, 800, 1080, image.width].filter((width) => width <= image.width)),
];
const SIZES = '(min-width: 48rem) 530px, 100vw';
---

{/*
 * Decorative (the chips name the products), so photos have `alt=""`. No frame: just the photo.
 * `mix-blend-multiply` turns the photos' white backgrounds into the panel's light blue. The box
 * keeps a fixed size whatever the images' aspect ratios (`object-contain`), so the loop never
 * shifts the layout. photoRotation.ts drives the loop through `data-state` on each slide.
 * The tile fades and slides in with the panel (`data-motion`). Its background is the panel's own
 * color: while it animates the tile is an isolated group, and the photos then multiply with it
 * instead of the panel behind, which looks the same.
 */}
<div
  class:list={[
    'relative h-72 bg-surface-container-low sm:h-80 md:aspect-square md:h-auto',
    className,
  ]}
  data-division-photo
  data-photo-rotator={rotates ? '' : undefined}
  data-motion="photo"
  style={panelMotionDelayStyle(PANEL_MOTION_DELAYS.photo())}
>
  {images.map((image, index) => (
    <Image
      src={image}
      alt=""
      widths={widthsFor(image)}
      sizes={SIZES}
      loading="lazy"
      decoding="async"
      data-slide={rotates ? '' : undefined}
      data-state={rotates ? states[index] : undefined}
      class:list={[
        'absolute inset-0 size-full object-contain mix-blend-multiply',
        rotates &&
          'opacity-0 transition-opacity duration-600 ease-in-out data-[state=active]:opacity-100 data-[state=idle]:hidden',
      ]}
    />
  ))}
</div>
