---
import { getContactChannels, getWhatsAppUrl } from '../../lib/data';
import { Container, Icon, IconTile, SectionHeader, type IconName } from '../ui';

interface ChannelLine {
  text: string;
  href?: string;
  /** Highlighted secondary line (shipping coverage). */
  accent?: boolean;
}

interface Channel {
  icon: IconName;
  title: string;
  lines: readonly ChannelLine[];
}

const HEADING_ID = 'contact-heading';

const { address, phones, emails, hours } = getContactChannels();
const whatsAppUrl = getWhatsAppUrl();

const toLinks = (links: typeof phones): ChannelLine[] =>
  links.map(({ label, href }) => ({ text: label, href }));

const channels: Channel[] = [
  {
    icon: 'location-on',
    title: 'Dirección de Operaciones',
    lines: [{ text: address.text }, { text: address.note, accent: true }],
  },
  { icon: 'call', title: 'Líneas Telefónicas', lines: toLinks(phones) },
  { icon: 'mail', title: 'Correo Electrónico', lines: toLinks(emails) },
  {
    icon: 'schedule',
    title: 'Horario de Atención',
    lines: [{ text: hours.text }, { text: hours.note }],
  },
];
---

<section
  id="contacto"
  aria-labelledby={HEADING_ID}
  class="w-full bg-surface-container-lowest py-space-xl lg:py-24"
>
  <Container>
    <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12">
      <div class="flex flex-col gap-space-lg lg:col-span-5">
        <SectionHeader
          headingId={HEADING_ID}
          heading="Contáctenos"
          lead="Atención personalizada para hospitales, clínicas, laboratorios clínicos y centros especializados en toda Colombia."
          leadSize="md"
        />

        {/* WhatsApp entry points: this button, the footer's social icon and the floating button (ADR-009). */}
        <a
          href={whatsAppUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 rounded-xl bg-surface-container-low px-space-lg py-3.5 text-label-lg text-on-surface shadow-sm transition-colors duration-200 hover:bg-surface-container"
        >
          <Icon name="chat" size={24} class="text-primary" />
          <span>
            Escríbanos por WhatsApp
            <span class="sr-only"> (abre WhatsApp en una pestaña nueva)</span>
          </span>
        </a>
      </div>

      <div class="lg:col-span-7">
        <ul class="grid grid-cols-1 gap-space-md sm:grid-cols-2">
          {channels.map(({ icon, title, lines }) => (
            <li class="flex items-start gap-4 rounded-xl bg-surface-container-low p-space-lg shadow-sm">
              <IconTile icon={icon} />
              {/* pt-2.5 centers the title on the 40px icon tile; the lines get their own gap below it. */}
              <div class="flex min-w-0 flex-col gap-space-sm pt-2.5">
                <h3 class="font-heading text-label-lg text-on-surface">{title}</h3>
                <div class="flex flex-col gap-1">
                  {lines.map(({ text, href, accent }) =>
                    href ? (
                      <a
                        href={href}
                        class="self-start rounded-sm text-body-sm wrap-anywhere text-on-surface-variant underline-offset-4 hover:text-primary hover:underline"
                      >
                        {text}
                      </a>
                    ) : (
                      <p
                        class:list={[
                          'text-body-sm',
                          accent ? 'font-medium text-primary' : 'text-on-surface-variant',
                        ]}
                      >
                        {text}
                      </p>
                    ),
                  )}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Container>
</section>
