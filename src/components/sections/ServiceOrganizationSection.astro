---
import { getServiceOrganization } from '../../lib/data';
import { Container, SectionHeader } from '../ui';
import DivisionCard from './DivisionCard.astro';

const HEADING_ID = 'service-organization-heading';

const { heading, lead, linkHint, divisions } = getServiceOrganization();
// On tablets (2 columns) a trailing odd card spans the full row instead of leaving a gap.
const lastOddIndex = divisions.length % 2 === 1 ? divisions.length - 1 : -1;

/*
 * Rows shared by the cards from xl (see DivisionCard): header, description, one per item slot and
 * footer. Item slots follow the busiest division, so shorter cards keep empty space under their
 * last item instead of stretching it.
 */
const ITEM_SLOTS = Math.max(...divisions.map(({ items }) => items.length));
const gridVars = `--division-items: ${ITEM_SLOTS}; --division-rows: ${ITEM_SLOTS + 3};`;
---

<section
  id="organizacion"
  aria-labelledby={HEADING_ID}
  class="w-full bg-surface-container-low py-space-xl lg:py-24"
>
  <Container class="flex flex-col gap-margin lg:gap-16">
    <!-- Same highlighted band as "POLÍTICA INTEGRADA"; uppercase is visual only, the copy stays as written. -->
    <SectionHeader
      headingId={HEADING_ID}
      heading={heading}
      lead={lead}
      highlight
      align="center"
      headingClass="uppercase"
    />

    <ul class="grid w-full grid-cols-1 gap-gutter md:grid-cols-2 xl:grid-cols-3" style={gridVars}>
      {divisions.map((division, index) => (
        <li
          class:list={[
            'xl:row-span-(--division-rows) xl:grid xl:grid-rows-subgrid xl:gap-y-0',
            index === lastOddIndex && 'md:col-span-2 xl:col-span-1',
          ]}
        >
          <DivisionCard division={division} linkHint={linkHint} />
        </li>
      ))}
    </ul>
  </Container>
</section>
