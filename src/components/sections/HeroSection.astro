---
import { Image } from 'astro:assets';
import heroImage from '../../assets/images/placeholders/hero-laboratory.webp';
import { getHeroCopy } from '../../lib/data';
import { Button, Chip, Container } from '../ui';

const HEADING_ID = 'hero-heading';
// WebM (VP9) first: Firefox on Linux may only have OpenH264, which stalls on non-Baseline H.264.
const HERO_VIDEO_SOURCES = [
  { src: '/videos/video_fondo.webm', type: 'video/webm' },
  { src: '/videos/video_fondo.mp4', type: 'video/mp4' },
] as const;

const { microSpecs } = getHeroCopy();
---

<section
  id="inicio"
  aria-labelledby={HEADING_ID}
  class="focus-ring-inverse relative flex min-h-screen-below-header w-full items-center overflow-hidden bg-scrim pt-space-xl pb-fab-clearance"
>
  {/*
    The photo stays underneath the video: it is the LCP element, it fills the frame while the
    video buffers or if it cannot play, and it is all that shows under reduced motion.
  */}
  <Image
    src={heroImage}
    alt=""
    width={1200}
    height={960}
    widths={[600, 900, 1200]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 size-full object-cover"
  />
  {/* Muted + playsinline: browsers (iOS Safari in particular) only autoplay silent inline video. */}
  <video
    autoplay
    muted
    loop
    playsinline
    data-looping-video
    aria-hidden="true"
    tabindex="-1"
    class="absolute inset-0 size-full object-cover motion-reduce:hidden"
  >
    {HERO_VIDEO_SOURCES.map(({ src, type }) => (
      <source src={src} type={type} />
    ))}
  </video>
  {/* 75%: lighter veil so the video reads through; recheck the blue highlight contrast if the footage changes. */}
  <div aria-hidden="true" class="absolute inset-0 bg-scrim/75"></div>

  <Container class="relative z-10">
    <div class="mx-auto flex max-w-4xl flex-col items-center gap-space-md text-center">
      <Chip variant="eyebrow" icon="verified-user">
        Tecnología médica y Farmacéutica en Colombia
      </Chip>

      <h1 id={HEADING_ID} class="text-start font-heading text-hero-title text-surface-bright">
        <span class="text-primary-container">Medsupplies Ingeniería S.A.S</span> soluciones
        integrales con Dispositivos Médicos, Productos Farmacéuticos e Ingeniería Especializada
      </h1>

      <p class="max-w-2xl text-hero-lead text-surface-variant">
        Distribuimos tecnología médica de vanguardia e insumos hospitalarios en Colombia, con el
        respaldo de soporte técnico, cumplimiento normativo y excelencia operativa.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-space-sm pt-space-xs">
        <Button href="/#contacto" variant="primary" iconStart="assignment">
          Solicitar cotización
        </Button>
        <Button href="/#productos" variant="neutral" iconStart="inventory-2">
          Ver portafolio de productos
        </Button>
      </div>

      {/*
        Fixed-width columns, stacked on phones: with content-sized items the second one moved
        (a layout shift) when the first grew as Inter replaced the fallback font.
      */}
      <ul class="grid gap-x-6 gap-y-space-xs pt-space-sm text-label-sm text-surface-variant sm:max-w-sm sm:grid-cols-2">
        {microSpecs.map((spec) => (
          <li class="flex items-center justify-center gap-1.5">
            <span aria-hidden="true" class="size-2 rounded-full bg-primary-fixed-dim" />
            {spec}
          </li>
        ))}
      </ul>
    </div>
  </Container>
</section>

<script>
  import { initLoopingVideos } from '../../lib/media/loopingVideo';

  initLoopingVideos();
</script>
