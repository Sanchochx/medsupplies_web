---
import type { HTMLAttributes } from 'astro/types';

type ContainerElement = 'div' | 'section' | 'header' | 'footer' | 'nav';

export interface ContainerProps extends HTMLAttributes<'div'> {
  /** Element to render; defaults to `div`. */
  as?: ContainerElement;
}

type Props = ContainerProps;

const { as: Element = 'div', class: className, ...attrs } = Astro.props;
---

<Element
  class:list={['mx-auto w-full max-w-page px-margin-mobile lg:px-margin', className]}
  {...attrs}
>
  <slot />
</Element>
