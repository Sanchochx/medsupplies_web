---
export type SectionHeaderAlign = 'start' | 'center';
export type SectionHeaderTone = 'light' | 'primary';
export type SectionHeadingLevel = 'h1' | 'h2' | 'h3';

export interface SectionHeaderProps {
  heading: string;
  /** Plain-text lead; use the `lead` slot instead when it needs inline markup. */
  lead?: string;
  /** Heading element; `h2` for regular page sections. */
  as?: SectionHeadingLevel;
  /** Lets the parent section reference the heading via `aria-labelledby`. */
  headingId?: string;
  align?: SectionHeaderAlign;
  /** `primary` for sections on the blue `primary` background. */
  tone?: SectionHeaderTone;
  leadSize?: 'md' | 'lg';
  /**
   * Paints the heading text on a solid `primary` band with `on-primary` text. The width cap then
   * applies to the lead only, so a short slogan can run on a single line.
   */
  highlight?: boolean;
  /** Extra classes for the heading element (e.g. sizing that depends on the heading's length). */
  headingClass?: string;
  /** Extra classes for the lead paragraph (e.g. keeping a lead on one line from a breakpoint). */
  leadClass?: string;
  class?: string;
}

type Props = SectionHeaderProps;

const TONE_CLASSES: Record<SectionHeaderTone, { heading: string; lead: string }> = {
  light: { heading: 'text-on-surface', lead: 'text-on-surface-variant' },
  primary: {
    heading: 'text-on-primary',
    lead: 'text-primary-fixed',
  },
};

const {
  heading,
  lead,
  as: Heading = 'h2',
  headingId,
  align = 'start',
  tone = 'light',
  leadSize = 'lg',
  highlight = false,
  headingClass,
  leadClass,
  class: className,
} = Astro.props;

const toneClasses = TONE_CLASSES[tone];
const hasLead = Boolean(lead) || Astro.slots.has('lead');
---

<div
  class:list={[
    'flex flex-col',
    !highlight && 'max-w-3xl',
    align === 'center' && 'mx-auto items-center text-center',
    className,
  ]}
>
  <Heading
    id={headingId}
    class:list={[
      'font-heading text-headline-xl-mobile tracking-tight md:text-headline-xl',
      !highlight && toneClasses.heading,
      headingClass,
    ]}
  >
    {highlight ? (
      // box-decoration-clone keeps padding and radius on every line when the heading wraps.
      <span class="rounded-lg bg-primary px-3 py-1 leading-[1.6] text-on-primary box-decoration-clone">
        {heading}
      </span>
    ) : (
      heading
    )}
  </Heading>
  {hasLead && (
    <p
      class:list={[
        'leading-relaxed',
        highlight && 'max-w-3xl',
        leadSize === 'lg' ? 'text-body-lg' : 'text-body-md',
        // The highlight band sits outside the heading's line box, so it needs extra room.
        highlight ? 'mt-space-lg' : leadSize === 'lg' ? 'mt-space-sm' : 'mt-2',
        toneClasses.lead,
        leadClass,
      ]}
    >
      {lead ?? <slot name="lead" />}
    </p>
  )}
</div>
