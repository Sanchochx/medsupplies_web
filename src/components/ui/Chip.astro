---
import Icon from './Icon.astro';
import type { IconName } from './iconNames';

export type ChipVariant = 'tag' | 'eyebrow' | 'inverse';

export interface ChipProps {
  /**
   * `tag`: small muted label. `eyebrow`: solid primary uppercase pill with an optional icon (hero).
   * `inverse`: translucent white pill with white text, for blue/dark surfaces.
   */
  variant?: ChipVariant;
  icon?: IconName;
  class?: string;
}

type Props = ChipProps;

const VARIANT_CLASSES: Record<ChipVariant, string> = {
  tag: 'bg-surface-container-high px-2.5 py-1 text-label-sm text-on-surface-variant',
  eyebrow:
    'gap-2 bg-primary px-3 py-1 text-label-sm text-on-primary font-semibold uppercase tracking-wider',
  inverse:
    'gap-2 border border-on-primary/25 bg-on-primary/12 px-3.5 py-1.5 text-label-lg text-on-primary',
};

const { variant = 'tag', icon, class: className } = Astro.props;
---

<span class:list={['inline-flex items-center rounded-full', VARIANT_CLASSES[variant], className]}>
  {icon && <Icon name={icon} size={18} />}
  <slot />
</span>
