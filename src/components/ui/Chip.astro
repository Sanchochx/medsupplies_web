---
import Icon from './Icon.astro';
import type { IconName } from './iconNames';

export type ChipVariant = 'tag' | 'eyebrow';

export interface ChipProps {
  /** `tag`: small muted label. `eyebrow`: uppercase pill with an optional icon (hero). */
  variant?: ChipVariant;
  icon?: IconName;
  class?: string;
}

type Props = ChipProps;

const VARIANT_CLASSES: Record<ChipVariant, string> = {
  tag: 'px-2.5 py-1 text-on-surface-variant',
  eyebrow: 'gap-2 px-3 py-1 text-primary font-semibold uppercase tracking-wider',
};

const { variant = 'tag', icon, class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full bg-surface-container-high text-label-sm',
    VARIANT_CLASSES[variant],
    className,
  ]}
>
  {icon && <Icon name={icon} size={18} />}
  <slot />
</span>
