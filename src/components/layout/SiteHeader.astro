---
import { Image } from 'astro:assets';
import logoPlaceholder from '../../assets/images/placeholders/logo-placeholder.svg';
import { getCompanyInfo } from '../../lib/data';
import { Button, Container } from '../ui';
import MainNav from './MainNav.astro';

const { legalName, wordmark, wordmarkSuffix } = getCompanyInfo();
---

<header
  data-site-header
  class="fixed inset-x-0 top-0 z-50 h-header border-b border-outline-variant/40 bg-surface-container-lowest/90 backdrop-blur-md"
>
  <Container class="flex h-full items-center justify-between gap-gutter">
    <a href="/#home" class="flex shrink-0 items-center gap-space-sm rounded-lg">
      {/* PLACEHOLDER: empty tile at the logo's final size until the brand identity is delivered. */}
      <Image
        src={logoPlaceholder}
        alt={legalName}
        width={32}
        height={32}
        loading="eager"
        class="size-8 rounded-lg border border-dashed border-outline bg-surface-container-high"
      />
      <span class="flex flex-col">
        <span class="font-heading text-headline-sm leading-tight font-bold tracking-tight text-on-surface">
          {wordmark}
        </span>
        <span class="text-label-sm tracking-wider text-primary uppercase">{wordmarkSuffix}</span>
      </span>
    </a>

    <MainNav />

    <div class="flex items-center gap-space-sm">
      <div class="hidden sm:flex">
        <Button href="/#contact" variant="primary" size="sm">
          Request a quote
        </Button>
      </div>
    </div>
  </Container>
</header>
