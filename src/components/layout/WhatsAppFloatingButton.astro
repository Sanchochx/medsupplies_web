---
import { getWhatsAppUrl } from '../../lib/data';
import { Icon } from '../ui';

const whatsAppUrl = getWhatsAppUrl();
---

{/*
  Floats over every section, so the focus indicator must read on light, blue and black
  backgrounds alike: a white ring hugging the button plus a dark outline around it.
  The float animation runs only under `motion-safe` and pauses on hover so the target holds still.
*/}
<a
  href={whatsAppUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbanos por WhatsApp (abre WhatsApp en una pestaña nueva)"
  class="fixed right-space-md bottom-space-md z-40 inline-flex size-14 items-center justify-center rounded-full bg-whatsapp text-on-primary shadow-xl [--focus-ring-color:var(--color-on-surface)] transition-colors duration-200 hover:bg-whatsapp-hover hover:[animation-play-state:paused] focus-visible:shadow-[0_0_0_2px_var(--color-surface-container-lowest)] motion-safe:animate-float sm:right-space-lg sm:bottom-space-lg"
>
  <Icon name="whatsapp" size={30} />
</a>
