---
import { Image } from 'astro:assets';
import logoPlaceholder from '../../assets/images/placeholders/logo-placeholder.svg';
import {
  getCompanyInfo,
  getContactChannels,
  getLegalLinks,
  getNavItems,
  getSocialLinks,
  type SocialNetwork,
} from '../../lib/data';
import { Container, Icon, type IconName } from '../ui';

const SOCIAL_ICONS: Record<SocialNetwork, IconName> = {
  linkedin: 'linkedin',
  instagram: 'instagram',
};

const { legalName, wordmark, description, complianceBadge, socialIntro, country } =
  getCompanyInfo();
const { address, phones, emails, hours } = getContactChannels();
const navItems = getNavItems();
const socialLinks = getSocialLinks();
const legalLinks = getLegalLinks();
// Evaluated at build time: the static page shows the year it was last deployed.
const year = new Date().getFullYear();

const contactItems: { icon: IconName; text: string; href?: string }[] = [
  { icon: 'location-on', text: address.text },
  ...phones.slice(0, 1).map(({ label, href }) => ({ icon: 'call' as const, text: label, href })),
  ...emails.slice(0, 1).map(({ label, href }) => ({ icon: 'mail' as const, text: label, href })),
  { icon: 'schedule', text: hours.text },
];

const headingClass = 'mb-space-md font-heading text-headline-sm text-on-surface';
const linkClass = 'rounded-sm transition-colors duration-150 hover:text-primary';
---

<footer class="border-t border-outline-variant/40 bg-surface-container-lowest text-body-sm text-on-surface-variant">
  <Container class="grid gap-space-xl py-space-xl md:grid-cols-2 lg:grid-cols-4">
    <div class="flex flex-col items-start gap-space-md">
      <span class="flex items-center gap-space-sm">
        {/* PLACEHOLDER: empty tile at the logo's final size until the brand identity is delivered. */}
        <Image
          src={logoPlaceholder}
          alt={legalName}
          width={32}
          height={32}
          class="size-8 rounded-lg border border-dashed border-outline bg-surface-container-high"
        />
        <h2 class="font-heading text-headline-sm font-bold tracking-tight text-on-surface">
          {wordmark}
        </h2>
      </span>
      <p>{description}</p>
      <p class="inline-flex items-center gap-space-xs rounded-lg bg-surface-container-low px-space-sm py-space-xs text-label-md text-primary">
        <Icon name="verified-user" size={16} />
        {complianceBadge}
      </p>
    </div>

    <nav aria-labelledby="footer-navigation-heading">
      <h2 id="footer-navigation-heading" class={headingClass}>
        Navigation
      </h2>
      <ul class="flex flex-col gap-space-sm">
        {navItems.map(({ label, href }) => (
          <li>
            <a href={href} class={linkClass}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class={headingClass}>Direct Contact</h2>
      <ul class="flex flex-col gap-space-sm">
        {contactItems.map(({ icon, text, href }) => (
          <li class="flex items-start gap-space-sm">
            <Icon name={icon} size={18} class="mt-0.5 text-primary" />
            {href ? (
              <a href={href} class={linkClass}>
                {text}
              </a>
            ) : (
              <span>{text}</span>
            )}
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class={headingClass}>Digital Presence</h2>
      <p class="mb-space-md">{socialIntro}</p>
      <ul class="flex gap-space-sm">
        {socialLinks.map(({ network, label, href }) => (
          <li>
            <a
              href={href}
              aria-label={label}
              class="inline-flex size-11 items-center justify-center rounded-lg bg-surface-container-high text-primary transition-colors duration-150 hover:bg-primary hover:text-on-primary"
            >
              <Icon name={SOCIAL_ICONS[network]} size={20} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Container>

  <Container>
    <div class="flex flex-col gap-space-sm border-t border-outline-variant/40 py-space-lg text-label-md md:flex-row md:items-center md:justify-between">
      <p>
        © {year} {legalName} All rights reserved. {country}.
      </p>
      <ul class="flex flex-col gap-space-sm md:flex-row md:gap-space-lg">
        {legalLinks.map(({ label, href }) => (
          <li>
            <a href={href} class={linkClass}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</footer>
