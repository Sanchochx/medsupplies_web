---
import { Image } from 'astro:assets';
import logo from '../../assets/images/logo.png';
import { getCompanyInfo } from '../../lib/data';
import { Container } from '../ui';

const { legalName, country } = getCompanyInfo();
// Evaluated at build time: the static page shows the year it was last deployed.
const year = new Date().getFullYear();
---

{/* Full white, not dimmed: at 75% opacity the text would drop to 4.4:1 on the brand blue. */}
<footer class="focus-ring-inverse bg-primary text-body-sm text-on-primary">
  <Container>
    <div class="flex flex-col gap-space-xs py-space-md md:flex-row md:items-center md:justify-between">
      <p>
        © {year} {legalName} Todos los derechos reservados. {country}.
      </p>
      <Image
        src={logo}
        alt={legalName}
        width={120}
        height={40}
        densities={[1, 2]}
        loading="lazy"
        class="h-10 w-auto self-start md:self-auto"
      />
    </div>
  </Container>
</footer>
