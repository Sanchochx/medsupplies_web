---
import { getCompanyInfo, getLegalLinks } from '../../lib/data';
import { Container } from '../ui';

const { legalName, country } = getCompanyInfo();
const legalLinks = getLegalLinks();
// Evaluated at build time: the static page shows the year it was last deployed.
const year = new Date().getFullYear();
---

{/* Full white, not dimmed: at 75% opacity the text would drop to 4.4:1 on the brand blue. */}
<footer class="focus-ring-inverse bg-primary text-body-sm text-on-primary">
  <Container>
    <div class="flex flex-col gap-space-sm py-space-lg md:flex-row md:items-center md:justify-between">
      <p>
        © {year} {legalName} Todos los derechos reservados. {country}.
      </p>
      <ul class="flex flex-col gap-space-sm md:flex-row md:gap-space-lg">
        {legalLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="rounded-sm underline-offset-4 transition-colors duration-150 hover:text-primary-fixed hover:underline"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</footer>
