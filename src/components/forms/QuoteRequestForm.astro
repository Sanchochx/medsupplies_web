---
import type { HTMLAttributes } from 'astro/types';
import { getConsentNotice, getRequestTypes } from '../../lib/data';
import { Button } from '../ui';
import { FIELD_CONTROL_CLASSES, FIELD_SINGLE_LINE_CLASSES } from './fieldStyles';
import FormField from './FormField.astro';

interface TextFieldSpec {
  name: string;
  label: string;
  type: 'text' | 'email' | 'tel';
  autocomplete: HTMLAttributes<'input'>['autocomplete'];
  placeholder: string;
}

const TITLE_ID = 'quote-form-title';

// Rendered in pairs: two columns from `sm`, one below.
const TEXT_FIELD_ROWS: readonly (readonly [TextFieldSpec, TextFieldSpec])[] = [
  [
    {
      name: 'fullName',
      label: 'Full Name',
      type: 'text',
      autocomplete: 'name',
      placeholder: 'e.g. Dr. Carlos Mendoza',
    },
    {
      name: 'institution',
      label: 'Healthcare Institution / Company',
      type: 'text',
      autocomplete: 'organization',
      placeholder: 'Clinic, hospital or laboratory',
    },
  ],
  [
    {
      name: 'email',
      label: 'Corporate Email',
      type: 'email',
      autocomplete: 'email',
      placeholder: 'name@institution.com',
    },
    {
      name: 'phone',
      label: 'Phone / Mobile',
      type: 'tel',
      autocomplete: 'tel',
      placeholder: '+57 300 000 0000',
    },
  ],
];

const requestTypes = getRequestTypes();
const { beforeLink, afterLink, policyLink } = getConsentNotice();
---

<div class="rounded-2xl bg-surface-container-lowest p-space-lg shadow-sm lg:p-space-xl">
  <div class="mb-space-md">
    <h3 id={TITLE_ID} class="font-heading text-headline-sm font-bold text-on-surface">
      Quote &amp; Advisory Request
    </h3>
    <p class="mt-1 text-body-sm text-on-surface-variant">
      Fill out the form below and a sales engineer will contact you shortly.
    </p>
  </div>

  {/* POST keeps personal data out of the URL; US-FRM-002 takes over submission with JS (D-15). */}
  <form
    id="quote-request-form"
    method="post"
    aria-labelledby={TITLE_ID}
    class="flex flex-col gap-space-sm"
  >
    {TEXT_FIELD_ROWS.map((row) => (
      <div class="grid grid-cols-1 gap-space-sm sm:grid-cols-2">
        {row.map(({ name, label, type, autocomplete, placeholder }) => (
          <FormField for={name} label={label} required>
            <input
              id={name}
              name={name}
              type={type}
              autocomplete={autocomplete}
              placeholder={placeholder}
              required
              class={FIELD_SINGLE_LINE_CLASSES}
            />
          </FormField>
        ))}
      </div>
    ))}

    <FormField for="requestType" label="Request Type" required>
      <select id="requestType" name="requestType" required class={FIELD_SINGLE_LINE_CLASSES}>
        <option value="" disabled selected>
          Select a category
        </option>
        {requestTypes.map(({ id, label }) => (
          <option value={id}>{label}</option>
        ))}
      </select>
    </FormField>

    <FormField for="message" label="Request Details / Specifications">
      <textarea
        id="message"
        name="message"
        rows="4"
        placeholder="Indicate references, estimated volumes or specific technical requirements..."
        class:list={[FIELD_CONTROL_CLASSES, 'resize-none py-3']}
      ></textarea>
    </FormField>

    <div class="flex items-start gap-2.5 pt-1">
      <input
        id="consent"
        name="consent"
        type="checkbox"
        required
        class="mt-0.5 size-4 shrink-0 cursor-pointer accent-primary"
      />
      <label for="consent" class="cursor-pointer text-body-sm leading-snug text-on-surface-variant">
        {beforeLink}{' '}
        {/* New tab so following the link never discards what the visitor already typed. */}
        <a
          href={policyLink.href}
          target="_blank"
          class="rounded-sm text-primary underline underline-offset-2 hover:text-secondary"
        >
          {policyLink.label}
          <span class="sr-only"> (opens in a new tab)</span>
        </a>{' '}
        {afterLink}
      </label>
    </div>

    <Button type="submit" size="lg" iconStart="send" fullWidth class="mt-2 active:scale-[0.99]">
      Send request
    </Button>
  </form>
</div>
