---
import { getWhatsAppUrl } from '../../lib/data';
import { Icon } from '../ui';

const whatsAppUrl = getWhatsAppUrl();
---

{/*
  The live region stays in the DOM, empty, from page load: screen readers only announce changes
  to regions they already know. The form script clones one template into it after a submission.
*/}
<div data-form-status role="status" aria-live="polite"></div>

<template data-status="success">
  <p class="flex items-center gap-2 rounded-lg bg-surface-container-high p-3 text-body-sm text-primary">
    <Icon name="check-circle" size={20} />
    Request sent! A specialist will contact you soon.
  </p>
</template>

<template data-status="error">
  <p class="rounded-lg bg-error-container p-3 text-body-sm text-on-error-container">
    We couldn't send your request. Your details are still in the form: please try again in a few
    minutes, or
    <a
      href={whatsAppUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-sm font-semibold underline underline-offset-2"
    >
      write to us on WhatsApp<span class="sr-only"> (opens WhatsApp in a new tab)</span>
    </a>
    {'.'}
  </p>
</template>
