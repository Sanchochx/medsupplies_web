# Copy this file to .env and fill in real values. Never commit .env.
# Variables prefixed with PUBLIC_ are exposed to the client; secrets must never use that prefix.

# Resend (contact form email delivery) — server-only
RESEND_API_KEY=re_xxxxxxxx
CONTACT_FROM_EMAIL=sender@verified-domain.example
CONTACT_TO_EMAIL=recipient@domain.example

# WhatsApp (international format, without "+")
PUBLIC_WHATSAPP_NUMBER=570000000000

# Site
PUBLIC_SITE_URL=https://example.com
